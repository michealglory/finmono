generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  INCOME
  EXPENSE
}

enum FileType {
  CSV
  XLSX
  PDF
  IMAGE
  TEXT
}

enum JobType {
  STATEMENT_IMPORT
  RECEIPT_IMPORT
}

enum JobStatus {
  PENDING
  PROCESSING
  NEEDS_REVIEW
  FAILED
  COMPLETED
}

model User {
  id             String                @id @default(cuid())
  email          String                @unique
  passwordHash   String
  baseCurrency   String                @default("NGN")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  accounts       Account[]
  categories     Category[]
  tags           Tag[]
  rules          ClassificationRule[]
  transactions   Transaction[]
  uploads        UploadedFile[]
  importJobs     ImportJob[]
  aiAudits       AIAudit[]
}

model Account {
  id            String         @id @default(cuid())
  userId        String
  name          String
  currency      String
  institution   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id             String        @id @default(cuid())
  userId         String
  parentId       String?
  name           String
  slug           String
  level          Int
  isSystem       Boolean       @default(false)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Category?     @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]    @relation("CategoryChildren")
  transactions   Transaction[]
  rules          ClassificationRule[]
  lineItems      TransactionLineItem[]

  @@unique([userId, slug])
  @@index([userId, level])
  @@index([userId, archivedAt])
}

model ClassificationRule {
  id            String      @id @default(cuid())
  userId        String
  categoryId    String
  keyword       String
  priority      Int         @default(100)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
}

model Transaction {
  id                  String                 @id @default(cuid())
  userId              String
  accountId           String
  categoryId          String?
  direction           Direction
  description         String
  merchantName        String?
  amountOriginal      Decimal                @db.Decimal(14, 2)
  originalCurrency    String
  amountBase          Decimal                @db.Decimal(14, 2)
  baseCurrency        String
  transactionDate     DateTime
  sourceHash          String?
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  account             Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category            Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lineItems           TransactionLineItem[]
  tags                TransactionTag[]
  imports             ImportedTransaction[]

  @@index([userId, transactionDate])
  @@index([accountId, transactionDate])
  @@index([userId, sourceHash])
}

model TransactionLineItem {
  id               String       @id @default(cuid())
  transactionId    String
  categoryId       String?
  itemTag          String?
  description      String
  quantity         Decimal?     @db.Decimal(10, 2)
  unitPrice        Decimal?     @db.Decimal(12, 2)
  amountOriginal   Decimal      @db.Decimal(14, 2)
  currency         String
  createdAt        DateTime     @default(now())
  transaction      Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category         Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags             LineItemTag[]

  @@index([transactionId])
}

model Tag {
  id            String           @id @default(cuid())
  userId        String
  name          String
  color         String?
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  TransactionTag[]
  lineItems     LineItemTag[]

  @@unique([userId, name])
  @@index([userId, archivedAt])
}

model TransactionTag {
  transactionId String
  tagId         String
  createdAt     DateTime      @default(now())
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

model LineItemTag {
  lineItemId    String
  tagId         String
  createdAt     DateTime           @default(now())
  lineItem      TransactionLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  tag           Tag                @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([lineItemId, tagId])
  @@index([tagId])
}

model FXRate {
  id            String     @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal    @db.Decimal(18, 8)
  rateDate      DateTime
  provider      String
  createdAt     DateTime   @default(now())

  @@unique([baseCurrency, quoteCurrency, rateDate])
  @@index([rateDate])
}

model UploadedFile {
  id             String      @id @default(cuid())
  userId         String
  path           String
  originalName   String
  mimeType       String
  sizeBytes      Int
  fileType       FileType
  rawText        String?
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  importJobs     ImportJob[]

  @@index([userId, createdAt])
}

model ImportJob {
  id               String                  @id @default(cuid())
  userId           String
  uploadedFileId   String?
  type             JobType
  status           JobStatus               @default(PENDING)
  errorSummary     String?
  outputJson       Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadedFile     UploadedFile?           @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)
  extractedRows    ImportedTransaction[]

  @@index([userId, status])
}

model ImportedTransaction {
  id                 String      @id @default(cuid())
  importJobId        String
  transactionId      String?
  dedupeHash         String
  rawPayload         Json
  proposedCategoryId String?
  confidence         Decimal?    @db.Decimal(5, 2)
  duplicateOfId      String?
  createdAt          DateTime    @default(now())
  importJob          ImportJob   @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  transaction        Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([importJobId])
  @@index([dedupeHash])
}

model AIAudit {
  id               String      @id @default(cuid())
  userId           String
  importJobId      String?
  model            String
  purpose          String
  prompt           String
  responseJson     Json
  createdAt        DateTime    @default(now())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
